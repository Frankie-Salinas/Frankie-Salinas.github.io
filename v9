				for(int i=0; i<newEdgeArr.length; i++) {
					newEdgeArr[i] = newEdgeArrExtended[i];
				}

	            boolean valid = true;
	            boolean[] seen = new boolean[8];
	            for (int val : newEdgeArr) {
	                if (val<0 || val>7 || seen[val]) {
	                    valid = false;
	                    break;
	                }
	                seen[val] = true;
	            }
	            
	            if (valid) {
	                epMoveTable[state][moveID] = permutationToInt(newEdgeArr);
	            } else {
	                epMoveTable[state][moveID] = -1; // Invalid transition for non-Phase-2 moves
	            }
			}
