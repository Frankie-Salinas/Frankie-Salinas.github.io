	public void generateSliceTables() {
	    
	    for(int state = 0; state < 24; state++) {
	        int[] slice = SliceIntToPerm(state);
	        int[] fullEdges = {0, 1, 2, 3, 4, 5, 6, 7, slice[0], slice[1], slice[2], slice[3]};
	        for(int moveID = 0; moveID < 18; moveID++) {
	            int[] newFull = applyEdgeMove(fullEdges, moveID);
	            int[] newSlice = {newFull[8], newFull[9], newFull[10], newFull[11]};
	            sliceMoveTable[state][moveID] = slicePermToInt(newSlice);
	        }
	    }
	    
	    for(int i = 0; i < 24; i++) slicePruningTable[i] = -1;
	    slicePruningTable[0] = 0;
	    
	    int depth = 0;
	    int filled = 1;
	    int[] phase2Moves = {0, 6, 12, 3, 9, 15, 13, 14, 16, 17};
	    
	    while(filled < 24) {
	    	boolean added = false;
	        for(int state = 0; state < 24; state++) {
	            if(slicePruningTable[state] == depth) {
	                for(int moveID : phase2Moves) {
	                    int nextState = sliceMoveTable[state][moveID];
	                    if(slicePruningTable[nextState] == -1) {
	                        slicePruningTable[nextState] = (byte)(depth + 1);
	                        filled++;
	                        added = true;
	                    }
	                }
	            }
	        }
	        if(!added) {break;}
	        depth++;
	    }
	}
	
