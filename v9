		int[] U_PERM = {3, 0, 1, 2, 4, 5, 6, 7}; // code with arrays like this tells us the final position after said move. For example, at index 0 the piece that ends up in slot zero is the one that comes from slot 3
		int[] R_PERM = {0, 2, 6, 3, 4, 1, 5, 7};
		int[] F_PERM = {0, 1, 3, 4, 5, 2, 6, 7};
		int[] D_PERM = {0, 1, 2, 3, 7, 4, 5, 6};
		int[] L_PERM = {7, 1, 2, 0, 3, 5, 6, 4};
		int[] B_PERM = {1, 6, 2, 3, 4, 5, 7, 0};
		int[][] list = {U_PERM, R_PERM, F_PERM, D_PERM, L_PERM, B_PERM};
		if (moveID <= 5) {
			return list[moveID];
	    } else {
	        // does nothing
	        return new int[]{0, 1, 2, 3, 4, 5, 6, 7}; 
	    }
	}
	public int[] getEdgePermutationForMove(int moveID) {
