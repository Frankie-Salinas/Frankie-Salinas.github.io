	public int[] generateCornerArr(int cord) { //helper method 1
		int[] arr = new int[8];
		int sum = 0;
		for(int i=6; i>=0; i--) {
			arr[i] = cord%3;
			sum += arr[i];
			cord /= 3;
		}
		arr[7] = (3-(sum%3))%3; // find the last cordinate
		return arr;
	}
	public int generateCornerNumber(int[] arr) { //helper method 2
		int cord = 0;
		for(int i=0; i<7; i++) { // 7 replaces arr.length
			cord = (cord*3) + arr[i];
		}
		return cord;
	}
	
