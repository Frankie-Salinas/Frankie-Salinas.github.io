	public int getPermCords(int[] perm) {
		int coord =0;
		int[] factorials = {5040, 720, 120, 24, 6, 2, 1, 1};
		for(int i=0; i<7; i++) {
			int count =0;
			for(int j=i+i; j<8; j++) {
				if(perm[j] < perm[i]) {count++;}
			}
			coord += (count * factorials[i]);
		}
		return coord;
	}	
	
	byte[] cpPruningTable = new byte[40320];
	byte[] epPruningTable = new byte[40320];
