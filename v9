	public byte[][] generateTwistsFlips(){
		byte[] twists = new byte[2187*495];
		byte[] flips = new byte[2048*495];
		for(int i=1; i<twists.length; i++) {twists[i] =-1;}
		for(int i=1; i<flips.length; i++) {flips[i] =-1;}
		int depth =0;
		int statesFilled =1; // index zero is depth zero - we already have done that one
		
		while(statesFilled < twists.length) {
			boolean added = false;
			for(int i=0; i<twists.length; i++) {
				if(twists[i] == depth) {
					int currentCord = i/495;
					int currentSlide = i%495;
					for(int moveID =0; moveID < 18; moveID++) {
						int nextCord = cordTable[currentCord][moveID];
						int nextSlice = sliceTable[currentSlide][moveID];
						int nextIndex = (nextCord*495) + nextSlice;
						if(twists[nextIndex] == -1) {
							twists[nextIndex] = (byte)(depth+1); // we start at zero - everything is 1 behind
							statesFilled++;
							added=true;
						}
					}
				}
			}
			if(!added) {break;}
			depth++;
		}
		depth =0;
		statesFilled =1;
		while(statesFilled < flips.length) {
			boolean added = false;
			for(int i=0; i<flips.length; i++) {
				if(flips[i] == depth) {
					int currentEdge = i/495;
					int currentSlide = i%495;
					for(int moveID =0; moveID < 18; moveID++) {
						int nextEdge = edgeTable[currentEdge][moveID];
						int nextSlice = sliceTable[currentSlide][moveID];
						int nextIndex = (nextEdge*495) + nextSlice;
						if(flips[nextIndex] == -1) {
							flips[nextIndex] = (byte)(depth+1); // we start at zero - everything is 1 behind
							statesFilled++;
							added = true;
						}
					}
				}
			}
			if(!added) {break;}
			depth++;
		}
		byte[][] arr = {twists, flips};
		return arr;
	}
		
