	public int[] intToPermutation(int state) {
		int[] perm = new int[8];
		int[] factorials = {5040, 720, 120, 24, 6, 2, 1};
		ArrayList<Integer> available = new ArrayList<>();
		for(int i=0; i<8; i++) {
			available.add(i);
		}
		for(int i=0; i<7; i++) {
			int index = state/factorials[i];
			perm[i] = available.remove(index);
			state = state % factorials[i];
		}
		perm[7] = available.get(0);
		return perm;
	}
	public int permutationToInt(int[] corners) {
		int coordinate = 0;
		int[] factorials = {5040, 720, 120, 24, 6, 2, 1, 1};
		for(int i=0; i<7; i++) {
			int smaller =0;
			for(int j=i+1; j<8; j++) {
				if(corners[j]<corners[i]) {
					smaller++;
				}
			}
			coordinate += (smaller*factorials[i]);
		}
		return coordinate;
	}
	public int[] SliceIntToPerm(int state) {
	    int[] perm = new int[4];
	    int[] factorials = {6, 2, 1};
	    ArrayList<Integer> available = new ArrayList<>();
	    
	    for(int i = 8; i <= 11; i++) {
	        available.add(i);
	    }
	    
	    for(int i = 0; i < 3; i++) {
	        int index = state / factorials[i];
	        perm[i] = available.remove(index);
	        state = state % factorials[i];
	    }
	    perm[3] = available.get(0);
	    return perm;
	}
	public int slicePermToInt(int[] slice) {
	    int coordinate = 0;
	    int[] factorials = {6, 2, 1, 1};
	    
	    for(int i = 0; i < 3; i++) {
	        int smaller = 0;
	        for(int j = i + 1; j < 4; j++) {
	            if(slice[j] < slice[i]) {
	                smaller++;
	            }
	        }
	        coordinate += (smaller * factorials[i]);
	    }
	    return coordinate;
	}

	public int[] applyCornerMove(int[] currentCorners, int moveID) {
		int[] newCorners = new int[8];
		int face = moveID%6; // handles double/prime moves
		int[] movePermutation = getCornerPermutationForMove(face);
		int count =1;
		if(moveID >= 12 && moveID < 18) {count = 2;} else if(moveID >= 6 && moveID < 12) {count = 3;}
		int[] temp = new int[currentCorners.length];
		for(int i=0; i<temp.length; i++) {temp[i] = currentCorners[i];}
		for(int i=0; i<count; i++) {
			for(int j=0; j<8; j++) {
				newCorners[j] = temp[movePermutation[j]];
			}
			for(int k=0; k<temp.length; k++) {temp[k] = newCorners[k];}
		}
		return newCorners;
	}
	public int[] applyEdgeMove(int[] currentEdges, int moveID) {
		int[] newEdges = new int[12];
		int baseFace = moveID%6;
		int[] movePermutation = getEdgePermutationForMove(baseFace);
		int turnCount =1;
		if(moveID >= 6 && moveID <=11) {turnCount =3;} else if(moveID >= 12 && moveID <= 17) {turnCount =2;}
		int[] temp = new int[12];
		for(int i = 0; i < 12; i++) { temp[i] = currentEdges[i]; }
		
		for(int c = 0; c < turnCount; c++) {
			for(int j = 0; j < 12; j++) {
				newEdges[j] = temp[movePermutation[j]];
			}
			for(int j = 0; j < 12; j++) {
				temp[j] = newEdges[j];
			}
		}
		return newEdges;
	}
