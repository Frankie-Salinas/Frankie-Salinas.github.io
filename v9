	public void generateCPPruningTable() {
		cpPruningTable[0]=0;
		for(int i=1; i<cpPruningTable.length; i++) {
			cpPruningTable[i]=-1;
		}
		int depth =0;
		int filled =1;
		while(filled<40320) {
			boolean added = false;
			for(int state = 0; state<40320; state++) {
				if(cpPruningTable[state] == depth) {
					for(int moveID : phase2Moves) {
						int nextState = cpMoveTable[state][moveID];
						if(cpPruningTable[nextState] == -1) {
							cpPruningTable[nextState] = (byte)(depth+1);
							filled++;
							added = true;
						}
					}
				}
			}
			if(!added) {break;}
			depth++;
		}
		
	}
