	public int getDistance(int cord, int edge, int slide) {
		int twistDistance = twists[(cord*495) + slide];
		int flipDistance = flips[(edge*495) + slide];
		if(twistDistance >= flipDistance) {return twistDistance;}
		return flipDistance;
	}
	public boolean searchPhase1(int cord, int edge, int slide, int currentDepth, int limit, int[] path, int lastMove) {
		int h = getDistance(cord, edge, slide);
		if(h==0) {return true;}
		if(currentDepth + h > limit) {
			return false;
		}
		for(int moveID =0; moveID < 18; moveID++) {
			if(isMoveBanned(moveID, lastMove)) {
				continue;
			}
			int nextCord = cordTable[cord][moveID];
			int nextEdge = edgeTable[edge][moveID];
			int nextSlide = sliceTable[slide][moveID];
			
			path[currentDepth] = moveID;
			if(searchPhase1(nextCord, nextEdge, nextSlide, currentDepth+1, limit, path, moveID)) { return true;}
		}
		return false;
	}
	public boolean isMoveBanned(int moveID, int lastMove) {
	    if (lastMove == -1) return false;
	    
	    int currentFace = moveID % 6;
	    int lastFace = lastMove % 6;
	    
	    if (currentFace == lastFace) {
	        return true;
	    }
	    

	    if (lastFace - currentFace == 3) {
	        return true;
	    }
	    
	    return false;
	}
	
