	public int[] generateSliceArr(int cord) {// a edge slot get 1 if it does not have a up/down piece
		int[] arr = new int[12];
		int k=3; // represents the 4 edges 3,2,1,0
		for(int n=11; n>=0; n--) {
			if(k>=0) {
				int x = choose(n,k);
				if(cord >= x) {
					cord -= x;
					arr[n] =0;
				} else {
					arr[n] =1;
					k--;
				}
			} else {
				arr[n] =0;
			}
		}
		return arr;
	}
	public int generateSliceNumber(int[] arr) {
		int s=0;
		int k=3; // 3,2,1,0 again
		for(int n=11; n>=0; n--) {
			if(k>=0) {
				if(arr[n] == 1) {
					k--;
				} else {
					s+= choose(n,k);
				}
			}
		}
		return s;
	}
	public int choose(int n, int k) {
		if(n < k || k < 0) {return 0;}
		if(k==0 || n==k) {return 1;}
		long x = 1; // a long replaces a int to prevent overflow happening in testing
		for(int i=0; i<k; i++) {
			x = x*(n-i)/(i+1); // a 1 was being used with a 1. This multiplies the exact same number on every iteration
		}
		return (int)x;
	}
		
