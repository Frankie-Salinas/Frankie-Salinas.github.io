	public String solvePhase2(int cp, int ep, int slice) {
		solution = "";
	    currentSolution = new int[20]; 
	    for (int maxDepth = 0; maxDepth < 20; maxDepth++) {
	        if (search(cp, ep, slice, maxDepth, 0, -1)) {
	            return solution; // soution found
	        }
	    }
	    System.out.println("No solution found within depth limit.");
		return "Error";
	}
	public static String solution = "";
	public boolean search(int cpState, int epState, int sliceState, int maxDepth, int currentDepth, int lastMove) {
	    if (currentDepth == maxDepth) {
	        if (cpState == 0 && epState == 0 && sliceState == 0) { 
	            printSolution(maxDepth);
	            return true;
	        }
	        return false;
	    }
	    
	    int cpDist = cpPruningTable[cpState];
	    int epDist = epPruningTable[epState];
	    int sliceDist = slicePruningTable[sliceState];
	    
	    if (cpDist == -1 || epDist == -1 || sliceDist == -1) {
	        return false;
	    }
	    
	    int maxDist = Math.max(cpDist, Math.max(epDist, sliceDist));
	    
	    if (maxDist > (maxDepth - currentDepth)) {
	        return false; 
	    }
	    int[] phase2Moves = {0, 6, 12, 3, 9, 15, 13, 14, 16, 17};
	    for (int moveID =0; moveID< phase2Moves.length; moveID++) {
	        int move = phase2Moves[moveID];
	        
	    	if(isMoveBanned(move, lastMove)) {continue;}
	        
	        currentSolution[currentDepth] = move;
	        
	        int nextCP = cpMoveTable[cpState][move];
	        int nextEP = epMoveTable[epState][move];
	        int nextSlice = sliceMoveTable[sliceState][move];
	        
	        if (search(nextCP, nextEP, nextSlice, maxDepth, currentDepth + 1, move)) {
	            return true;
	        }
	    }
	    return false;
	}
	public void printSolution(int length) {
        System.out.print("Solution: ");
	    for (int i = 0; i < length; i++) {
	        int moveID = currentSolution[i];
	        System.out.print(moveNames[moveID] + " ");
	        solution += moveNames[moveID] + " ";
	    }
	    System.out.println();
	}
