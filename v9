	public int turn(int x, int times) {
		int num = 0;
		int passed = x;
		int[] CCclockwise = {7,4,1,8,5,2,9,6,3};
		int[] clockwise = {3,6,9,2,5,8,1,4,7};
		if(times==0) {
			return passed;
		} else if(times>0) {
			for(int i=0; i<times; i++) {
				for(int j=0; j<clockwise.length; j++) {
					num = (num*10) + passed % (int)Math.pow(10, clockwise[j])/((int)Math.pow(10, clockwise[j]-1));
				}
				if(times-1 > i) {passed = num; num = 0;}
			}
		} else {
			for(int i=0; i>times; i--) {
				for(int j=0; j<CCclockwise.length; j++) {
					num = (num*10) + passed % (int)Math.pow(10, CCclockwise[j])/((int)Math.pow(10, CCclockwise[j]-1));
				}
				if(times+1 < i) {passed = num; num =0;}
			}
		} 
		return num;
	}
