	public void pruneTable(int[] cube, boolean inPhaseTwo, int depth){ // 2 maps, and the list should be the key for both
		int[] arr = new int[6];
		String[] lastMove = {"u'", "d'", "u", "d", "u2", "r2", "b2", "l2", "f2", "d2"}; // backwards because otherwise you would print order from solved to state, not state to solved
		List<Integer> oldCube = new ArrayList<>();
		Queue<List<Integer>> queue = new LinkedList<>(); // queue of integer replaced with queue of list<integer> to preserve the keys in the map
		List<Integer> list = new ArrayList<>();
		list = turnFace(cube, lastMove, inPhaseTwo, false);
		for(int i=0; i<list.size(); i+=6) {
			List<Integer> startMap = new ArrayList<>();
			for(int j=0; j<arr.length; j++) {
				startMap.add(list.get(i+j));
			}
			queue.offer(startMap);
			table.put(startMap, lastMove[i/6]);
		}
		
		int pow = (int)Math.pow(18, depth); // switches between 10 and 18. 10= 111 ms, 18 = 413 ms
		for(int i=0; i<pow; i++) {
			List<Integer> nextQueue = queue.remove();
			oldCube = new ArrayList<>();
			for(int a=0; a<arr.length; a++){
				arr[a] = nextQueue.get(a);
				oldCube.add(arr[a]);
			} 	
			list = turnFace(arr, lastMove, inPhaseTwo, false);
			for(int j=0; j<list.size(); j+=6) {
				List<Integer> nextCube = new ArrayList<>();
				for(int k=0; k<arr.length; k++) {
					nextCube.add(list.get(j+k));
				}
				if(!table.containsKey(nextCube)) {
					table.put(nextCube, lastMove[j/6] + " " + table.get(oldCube)); 
					queue.offer(nextCube); //for(int k=0; k<arr.length; k++) { queue.offer(list);}
				}
				//nextCube.clear(); - sets the key values to [] each time (nothing in list)
			}
		}
		map.clear();
	}
	public boolean inPhaseTwo(int[] arr) {
		int[] pow = {1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000};
		int Face =0;
		int num =0;
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 1) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		for(int i=0; i<9; i++) {
			num = (Face/pow[i])%10;
			if(num != 1 && num != 6) {
				return false;
			}
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 6) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		for(int i=0; i<9; i++) {
			num = (Face/(int)pow[i])%10;
			if(num != 1 && num != 6) {
				return false;
			}
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 3) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		if((Face/1000)%10 != 3 && (Face/1000)%10 != 5) {
			return false;
		}
		if((Face/100000)%10 != 3 && (Face/100000)%10 != 5) {
			return false;
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 5) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		if((Face/1000)%10 != 3 && (Face/1000)%10 != 5) {
			return false;
		}
		if((Face/100000)%10 != 3 && (Face/100000)%10 != 5) {
			return false;
		}
		return true;
	}

	
