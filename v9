	public void generateEPMoveTable() {
		for(int state =0; state < 40320; state++) {
			int[] edgeArr = intToPermutation(state);
			int[] edgeArrExtended = new int[12];
			for(int i=0; i<edgeArr.length; i++) {edgeArrExtended[i] = edgeArr[i];}
			for(int i=8; i<=11; i++) {edgeArrExtended[i] = i;}
