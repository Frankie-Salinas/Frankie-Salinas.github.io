	public boolean pruneTable(int[] cube, boolean inPhaseTwo, int depth, String[] lastMove, int[] startCube){ // 2 maps, and the list should be the key for both
		int[] passed = new int[6];
		List<Integer> startCubeList = new ArrayList<>();
		for(int i=0; i<startCube.length; i++) { startCubeList.add(startCube[i]);}
		List<Integer> oldCube = new ArrayList<>();
		Queue<List<Integer>> queue = new LinkedList<>();
		int[] arr = new int[lastMove.length*6]; 
		arr = turnFace(cube, lastMove, inPhaseTwo);
		for(int i=0; i<lastMove.length*6; i+=6) {
			List<Integer> startMap = new ArrayList<>();
			for(int j=0; j<passed.length; j++) {
				startMap.add(arr[i+j]);
			} 
			queue.offer(startMap);
			table.put(startMap, lastMove[i/6]);  // last move has a length of 10
		}
		int pow = (int)Math.pow(10, depth); // switches between 10 and 18. 10= 111 ms, 18 = 413 ms
		for(int i=0; i<pow; i++) {
			List<Integer> nextQueue = queue.remove();
			for(int a=0; a<passed.length; a++){
				passed[a] = nextQueue.get(a);
				oldCube.add(passed[a]);
			} 	
			arr = turnFace(passed, lastMove, inPhaseTwo);
			for(int j=0; j<lastMove.length*6; j+=6) {
				if(arr[j] != 0) { // new
					List<Integer> nextCube = new ArrayList<>();
					for(int k=0; k<passed.length; k++) {
						nextCube.add(arr[j+k]);
					}
					if(!table.containsKey(nextCube)) {
						table.put(nextCube, lastMove[j/6] + " " +table.get(oldCube)); // slow line`
						if(startCubeList.equals(nextCube)) { 
							System.out.println("Solution: " + table.get(nextCube)); 
							System.out.println("Took " + (System.nanoTime()-startTime)/1000000 + " ms"); 
							Runtime runtime = Runtime.getRuntime();
							long usedMemory = runtime.totalMemory() - runtime.freeMemory();
							System.out.println("Used " + usedMemory/1000000 + " MB"); return true;}
						List<Integer> list = new ArrayList<>();
						for(int k=0; k<6; k++) {
							list.add(arr[j+k]);
						}
						queue.offer(list);
					}
				}
			}
			oldCube.clear();// arr used to be called list, and passed used to be called arr. here used to be list.clear(); (next line)
		}
		
		queue.clear();
		map.clear();
		return false;
	}

	
	public boolean inPhaseTwo(int[] arr) {
		int[] pow = {1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000};
		int Face =0;
		int num =0;
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 1) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		for(int i=0; i<9; i++) {
			num = (Face/pow[i])%10;
			if(num != 1 && num != 6) {
				return false;
			}
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 6) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		for(int i=0; i<9; i++) {
			num = (Face/(int)pow[i])%10;
			if(num != 1 && num != 6) {
				return false;
			}
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 3) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		if((Face/1000)%10 != 3 && (Face/1000)%10 != 5) {
			return false;
		}
		if((Face/100000)%10 != 3 && (Face/100000)%10 != 5) {
			return false;
		}
		for(int i=0; i<arr.length; i++) {
			if(arr[i]/10000%10 == 5) {
				Face = arr[i];
				i=arr.length; // break
			}
		}
		if((Face/1000)%10 != 3 && (Face/1000)%10 != 5) {
			return false;
		}
		if((Face/100000)%10 != 3 && (Face/100000)%10 != 5) {
			return false;
		}
		return true;
	}

	
