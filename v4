	public boolean isCornerOrientated(String cube) { // checks corner orientation provide white , yellow, green or blue index
		byte[] indexNum = {0,2,6,8,27,29,33,35};
		for(int i=0; i<indexNum.length; i++) {
			char c = cube.charAt(indexNum[i]);
			if(c != 'U' && c != 'D') {
				return false;
			}
		}
		return true;
	}
	public boolean isEdgeOrientated(String cube) { // checks edge orientation
		byte[] indexNum2 = {1,3,5,7,28,30,32,34,21,23,48,50};
		for(int i=0; i<indexNum2.length; i++) {
			char c = cube.charAt(indexNum2[i]);
			if(i<8) {
				if(c != 'U' && c != 'D') {
					return false;
				}
			} else {
				if(c != 'F' && c != 'B') {
					return false;
				}
			}
		}
		return true;
	}
