	public String cornerBase3(String cube) { // checks corner orientation to get key for pattern with isCornerOrientated 
		String strNum ="";
		for(byte i=0; i<=35; i+=2) {
			if(i == 4) {
				i=6;
			}
			if(i == 10) {
				i = 27;
			}
			if(i == 31) {
				i = 33;
			}
			if(isCornerOrientated(cube, i) == 0) {
				strNum = strNum + "0";
			} else if(isCornerOrientated(cube, i) == 1) {
				strNum = strNum + "1";
			} else {
				strNum = strNum + "2";
			}
		}
		return strNum;
	}
