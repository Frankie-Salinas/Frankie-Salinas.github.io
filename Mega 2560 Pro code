void getCornerOrientation(){ //   URF, UFL, ULB, UBR, DFR, DLF, DBL, DRB, (white = 0, y=1, r=2, o=3, g=4, b=5)
  int indexes[] = {8,6,0,2,47,45,51,53}; // this method looks if the white/yellow corners have a white/yellow sticker on the top/bottom. if not, it checks if said corner is clockwise/ccw
  int clockwiseIndexes[] = {27,18,9,36,26,17,44,36};
  for(int i=0; i<8; i++){
    if(cube[indexes[i]] == 0 || cube[indexes[i]] == 1){
      cornerOrientation[i] = 0;
    } else if(cube[clockwiseIndexes[i]] == 0 || cube[clockwiseIndexes[i]] == 1){
      cornerOrientation[i] = 1;
    } else {cornerOrientation[i] = 2;} // must be counterclockwise
  }
}
void getEdgeFlip(){ //UR, UF, UL, UB, DR, DF, DL, DB, FR, FL, BL, BR
  int indexes[] = {5,7,3,1,50,46,48,52,23,21,39,41};
  for(int i=0; i<12; i++){
    if(i<8 && (cube[indexes[i]] == 0 || cube[indexes[i]] == 1)){edgeFlip[i] = 0;} else {edgeFlip[i] = 1;}
    if(i>=8 && (cube[indexes[i]] == 4 || cube[indexes[i]] == 5)){edgeFlip[i] = 0;} else {edgeFlip[i] = 1;}
  }
}
int getSlicePosition() {
  int indexes1[] = {5, 7, 3, 1, 50, 46, 48, 52, 23, 21, 39, 41};
  int indexes2[] = {28, 19, 10, 52, 34, 25, 16, 43, 30, 14, 32, 12};

  byte sliceColors[4][2] = {
    {4, 2}, 
    {4, 3}, 
    {5, 3}, 
    {5, 2}
  };

  int foundCount = 0;
  int sliceMask = 0;

  for (int i = 11; i >= 0; i--) {
    byte c1 = cube[indexes1[i]];
    byte c2 = cube[indexes2[i]];
    bool isSliceEdge = false;
    for (int id = 0; id < 4; id++) {
      if ((c1 == sliceColors[id][0] && c2 == sliceColors[id][1]) || 
          (c1 == sliceColors[id][1] && c2 == sliceColors[id][0])) {
        isSliceEdge = true;
        break;
      }
    }

    if (isSliceEdge) {
      sliceMask += choose(i, foundCount + 1);
      foundCount++;
      if (foundCount == 4) break; // Stop once we found all 4 slice edges
    }
  }

  return sliceMask; // 0-495
}
int choose(int n, int k) { // helper
  if (k > n) return 0;
  if (k == 0 || k == n) return 1;
  int res = 1;
  for (int i = 1; i <= k; i++) {
    res = res * (n - i + 1) / i;
  }
  return res;
}

