void writeRegister(uint8_t reg, uint8_t value) {
  myI2C.beginTransmission(TCS_ADDRESS);
  myI2C.write(0x80 | reg);
  myI2C.write(value);
  myI2C.endTransmission();
}
uint8_t readRegister(uint8_t reg) {
  myI2C.beginTransmission(TCS_ADDRESS);
  myI2C.write(0x80 | reg);
  myI2C.endTransmission();

  myI2C.requestFrom((uint8_t)TCS_ADDRESS, (uint8_t)1);
  if (myI2C.available()) {
    return myI2C.read();
  }
  return 0;
}
uint16_t read16(uint8_t reg) {
  myI2C.beginTransmission(TCS_ADDRESS);
  myI2C.write(0x80 | reg);
  myI2C.endTransmission();

  myI2C.requestFrom((uint8_t)TCS_ADDRESS, (uint8_t)2);
  if (myI2C.available() >= 2) {
    uint16_t low = myI2C.read();
    uint16_t high = myI2C.read();
    return (high << 8) | low;
  }
  return 0;
}




void setup() {
  Serial.begin(9600);
  delay(100);
  
  myI2C.begin(); // starts the designated pins as I2C for the SDA/SCL
  delay(100);

  // Initialize motor pins and start button
  for(int i = 0; i < 6; i++) {
    for(int j = 0; j < 4; j++) {
      pinMode(pins[i][j], OUTPUT);
    }
  }
  pinMode(startButton, INPUT_PULLUP);

  // Initialize each sensor connected to channels 0 through 3
  for (int ch = 0; ch < 4; ch++) {
    tcaselect(ch);
    delay(10);
    
    // Power on each sensor
    writeRegister(0x00, 0x01);
    delay(3);
    writeRegister(0x00, 0x03);
    writeRegister(0x01, 0xEB);
    writeRegister(0x0F, 0x01); 
  }
}
