void getCornerPermutation() {
  int indexes1[] = {8,  6,  0,  2,  47, 17, 15, 35};
  int indexes2[] = {20, 11, 9,  29, 33, 24, 44, 42};
  int indexes3[] = {27, 18, 38, 36, 26, 45, 51, 53};

  byte cornerColors[8][3] = {
    {0, 4, 2}, {0, 4, 3}, {0, 5, 3}, {0, 5, 2},
    {1, 4, 2}, {1, 4, 3}, {1, 5, 3}, {1, 5, 2}
  };

  for (int i = 0; i < 8; i++) {
    byte c1 = cube[indexes1[i]];
    byte c2 = cube[indexes2[i]];
    byte c3 = cube[indexes3[i]];
    for (int pieceID = 0; pieceID < 8; pieceID++) {
      if ((c1 == cornerColors[pieceID][0] || c1 == cornerColors[pieceID][1] || c1 == cornerColors[pieceID][2]) &&
          (c2 == cornerColors[pieceID][0] || c2 == cornerColors[pieceID][1] || c2 == cornerColors[pieceID][2]) &&
          (c3 == cornerColors[pieceID][0] || c3 == cornerColors[pieceID][1] || c3 == cornerColors[pieceID][2])) {
        cornerPermutation[i] = pieceID;
        break;
      }
    }
  }
}
void getEdgePermutation() {
  int indexes1[] = {5,  7,  3,  1,  50, 46, 48, 52, 23, 21, 39, 41};
  int indexes2[] = {28, 19, 10, 52, 34, 25, 16, 43, 30, 14, 32, 12};

  byte edgeColors[12][2] = {
    {0, 2}, {0, 4}, {0, 3}, {0, 5}, // UR, UF, UL, UB
    {1, 2}, {1, 4}, {1, 3}, {1, 5}, // DR, DF, DL, DB
    {4, 2}, {4, 3}, {5, 3}, {5, 2}  // FR, FL, BL, BR
  };

  for (int i = 0; i < 12; i++) {
    byte c1 = cube[indexes1[i]];
    byte c2 = cube[indexes2[i]];
    for (int j = 0; j < 12; j++) {
      if ((c1 == edgeColors[j][0] && c2 == edgeColors[j][1]) || 
          (c1 == edgeColors[j][1] && c2 == edgeColors[j][0])) {
        edgePermutation[i] = j;
        break;
      }
    }
  }
}
int getSlicePermutation() {
  int indexes1[] = {23, 21, 39, 41}; // FR, FL, BL, BR slot primary stickers
  int indexes2[] = {30, 14, 32, 12}; // FR, FL, BL, BR slot secondary stickers

  byte sliceColors[4][2] = {
    {4, 2}, {4, 3}, {5, 3}, {5, 2} // IDs 8, 9, 10, 11
  };
  for (int i = 0; i < 4; i++) {
    byte c1 = cube[indexes1[i]];
    byte c2 = cube[indexes2[i]];

    for (int id = 0; id < 4; id++) {
      if ((c1 == sliceColors[id][0] && c2 == sliceColors[id][1]) || 
          (c1 == sliceColors[id][1] && c2 == sliceColors[id][0])) {
        slice[i] = id; // Stores 0, 1, 2, or 3
        break;
      }
    }
  }

  // Convert to a 0-23 permutation integer using factorial math
  int permValue = 0;
  int factor[] = {1, 1, 2, 6};
  for (int i = 0; i < 4; i++) {
    int smallerCount = 0;
    for (int j = i + 1; j < 4; j++) {
      if (slice[j] < slice[i]) smallerCount++;
    }
    permValue += smallerCount * factor[3 - i];
  }
  return permValue;
}



int complimentNum(int n){ // this method tells the other 2 color sensors on the left side what face ther are looking at. It returns the index of the middle of the face
  if(n == 4){return 49;}
  if(n == 22){return 40;}
  if(n == 31){return 22;}
  return -1; // error
}
void scanColors(int n){// This method scans the entirety of the current right and left face. It scan a corner, then a edge and rotates the cube so that a new corner and edge can be scanned.
  uint16_t r, g, b, c;
  for(int i=0; i<=3; i++){
    tcaselect(0);
    delay(100); // Stabilization delay for I2C bus
    c = read16(0x14); r = read16(0x16); g = read16(0x18); b = read16(0x1A);
    cube[n-3] = (returnColor(r,g,b,c));
    tcaselect(1);
    delay(100);
    c = read16(0x14); r = read16(0x16); g = read16(0x18); b = read16(0x1A);
    cube[n-2] = (returnColor(r,g,b,c));
    tcaselect(2);
    delay(100);
    c = read16(0x14); r = read16(0x16); g = read16(0x18); b = read16(0x1A);
    cube[complimentNum(n)-3] = (returnColor(r,g,b,c));
    tcaselect(3);
    delay(100);
    c = read16(0x14); r = read16(0x16); g = read16(0x18); b = read16(0x1A);
    cube[complimentNum(n)-2] = (returnColor(r,g,b,c));
    rotateSides("R", "L");
    delay(100);
  }
}
