void tcaselect(uint8_t i) { // this method checks to see if you are looking for a valid channel. If so, it turns the number into bitwise shift operator to tell the chip to open the channel
  if (i > 7) return;
  myI2C.beginTransmission(TCAADDR);
  myI2C.write(1 << i);
  myI2C.endTransmission();
}
void selectChannel(byte channel) { // This function does the same as the previous method, but specifically for the PCA-branded pca9548A chip
  if (channel > 7) {
    return;
  }
  myI2C.beginTransmission(PCA_ADDRESS);
  myI2C.write(1 << channel);
  byte error = myI2C.endTransmission();
  if (error != 0) {
    Serial.print("PCA9548A error: ");
    Serial.println(error);
  }
}
void scanChannel(byte channel) { //this method loops through every possible I2C address (126 of them) and attempts a transmission. If a sensor responds, it retusn no error.
  Serial.print("Scanning channel ");
  Serial.println(channel);
  selectChannel(channel);
  delay(10);
  for (byte address = 1; address < 127; address++) {
    myI2C.beginTransmission(address);
    byte error = myI2C.endTransmission();
    if (error == 0) {
      if (address < 16) {
        Serial.print("0");
      }
      Serial.println(address, HEX); // turns address into hex(base 16)
    }
  }
}




int permutationToInt(int perm[], int size) {
  int permValue = 0;
  for (int i = 0; i < size; i++) {
    int smallerCount = 0;
    for (int j = i + 1; j < size; j++) {
      if (perm[j] < perm[i]) smallerCount++;
    }
    int fact = 1;
    for (int k = 1; k <= (size - 1 - i); k++) {
      fact *= k;
    }
    permValue += smallerCount * fact;
  }
  return permValue;
}
int getCornerOrientationInt() {
  int cord = 0;
  for (int i = 0; i < 7; i++) {
    cord = cord * 3 + cornerOrientation[i];
  }
  return cord;
}
int getEdgeFlipInt() {
  int edgeCode = 0;
  for (int i = 0; i < 11; i++) {
    edgeCode = (edgeCode << 1) | edgeFlip[i];
  }
  return edgeCode;
}
void sendDataToSolver() {
  getCornerPermutation(); 
  getEdgePermutation();
  getCornerOrientation();
  getEdgeFlip();

  int currentCP        = permutationToInt(cornerPermutation, 8);
  int currentEP        = permutationToInt(edgePermutation, 12);
  int currentSlicePerm = getSlicePermutation();
  int initialCord      = getCornerOrientationInt();
  int initialEdge      = getEdgeFlipInt();
  int initialSlice     = getSlicePosition();

  // 3. Print all 6 integers separated by commas, ending with a newline for Java
  Serial.print(currentCP); Serial.print(",");
  Serial.print(currentEP); Serial.print(",");
  Serial.print(currentSlicePerm); Serial.print(",");
  Serial.print(initialCord); Serial.print(",");
  Serial.print(initialEdge); Serial.print(",");
  Serial.println(initialSlice); // println adds the \n that Java's serial listener waits for
  while (Serial.available() == 0) {
  }
  String solution = Serial.readStringUntil('\n');
  solution.trim();
  delay(100);
  solve(solution);
}



