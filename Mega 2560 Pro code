/* this method takes a sensors raw RGB / Clear data and makes a guess on what color is being passed. It takes the hardcoded color data, and subtracts the difference for each value, then sums 
everything for a total score. The color with the lowest score wins. For example, a color with R,G,B,C data with 100,100,100,100 will match closely with passed values that look something
 like 101, 98, 107, 104 vs a color with data like 180, 190, 45, 200*/
int returnColor(int red, int green, int blue, int clear){ // returns the color that matches closest to data in the form a number (white = 0, y=1, r=2, o=3, g=4, b=5)
  int scores[] {32767, 32767, 32767, 32767, 32767, 32767}; // int max is 32767
  for(int i=0; i<6; i++){
    int score1 = abs(colorArr[i][0]-red);
    int score2 = abs(colorArr[i][1]-green);
    int score3 = abs(colorArr[i][2]-blue);
    int score4 = abs(colorArr[i][3]-clear);
    scores[i]= score1 + score2 + score3 + score4;
  }
  int lowest = 32767;
  int returned = -1;
  for(int i=0; i<6; i++){
    if(scores[i] < lowest){lowest = scores[i], returned =i;}
  }
  return returned;
}
/*this code takes the return string, breaks it up individually, and passes each letter to the rotate methods */
void solve(String solution){ // pass a string(ex: u f2 d' r l)
  for(int i = 0; i < solution.length(); i++){
    if(solution.substring(i, i+1).equals(" ")) { continue; }
    if(i + 1 < solution.length() && solution.substring(i+1, i+2).equals("2")){
      rotate2(solution.substring(i, i+2)); 
      i++;
      continue;
    }
    if(i + 1 < solution.length() && solution.substring(i+1, i+2).equals("'")){
      rotatePrime(solution.substring(i, i+2)); 
      i++;
      continue;
    }
    for(int j = 0; j < 6; j++){ 
      if(solution.substring(i, i+1).equalsIgnoreCase(moves[j])){
        rotate(solution.substring(i, i+1));
        break;
      }
    }
  }
}







